#define DEFAULT 0   
#define CANARY  1
#define GAMING  2
#define SYM     3
#define FUN     4
#define MOUSE   5
#define SCROLL  6
#define SNIPE   7
#define NAV     8

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {

    behaviors {
        nav_tap: navigation_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>; 
            bindings = <&mo>, <&to>; 
        };
    };



    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC                 &kp N1     &kp N2        &kp N3        &kp N4  &kp N5                                   &kp N6           &kp N7  &kp N8     &kp N9   &kp N0         &kp BSPC
&kp TAB                 &kp Q      &kp W         &kp E         &kp R   &kp T                                    &kp Y            &kp U   &kp I      &kp O    &kp P          &kp BACKSLASH
&kp CAPS                &kp A      &kp S         &kp D         &kp F   &kp G                                    &kp H            &kp J   &kp K      &kp L    &kp SEMI       &kp SQT
&kp LEFT_SHIFT          &kp Z      &kp X         &kp C         &kp V   &kp B        &kp PAGE_DOWN  &kp PAGE_UP  &kp N            &kp M   &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
&nav_tap NAV DEFAULT    &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &mo 7   &lt 5 SPACE  &mo 6          &kp ENTER    &lt 3 BACKSPACE                              &kp RIGHT_ALT  &kp DELETE
            >;
        };

        canary_layer {
            label = "CNRY";
            bindings = <
&kp ESC                 &kp N1     &kp N2        &kp N3        &kp N4  &kp N5                                   &kp N6           &kp N7  &kp N8     &kp N9   	&kp N0         &kp BSPC
&kp TAB                 &kp W      &kp L         &kp Y         &kp P   &kp B                                    &kp Z            &kp F   &kp O      &kp U    	&kp SQT        &kp BACKSLASH
&kp CAPS                &kp C      &kp R         &kp S         &kp T   &kp G                                    &kp M            &kp N   &kp E      &kp I    	&kp A          &trans
&kp LEFT_SHIFT          &kp Q      &kp J         &kp V         &kp D   &kp K        &kp PAGE_DOWN  &kp PAGE_UP  &kp X            &kp H   &kp FSLH   &kp COMMA   &kp DOT        &kp RIGHT_SHIFT
&nav_tap NAV DEFAULT    &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &mo 7   &lt 5 SPACE  &mo 6          &kp ENTER    &lt 3 BACKSPACE                              	&kp RIGHT_ALT  &kp DELETE
            >;
        };


        gaming_layer {
            label = "GAMING";
            bindings = <
&trans  	        	&trans 	&trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans          		&trans  &kp Q   &kp W   &kp E   &trans                      &trans  &trans  &kp UP  &trans  &trans  &trans
&trans  	        	&trans  &kp A   &kp S   &kp D   &kp F                       &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  		        &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&nav_tap NAV DEFAULT	&trans  &trans  &trans  &trans  &kp ESC &kp RET &kp Z   &trans                  &trans  &trans
            >;
        };


        symbol_layer {
            label = "SYM-BT";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans           &trans        &trans        &trans        &trans                       &trans          &trans         &trans            &trans                &trans                 &trans
&trans  &bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans
&trans  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &kp UNDERSCORE  &kp PLUS       &trans            &trans                &trans                 &trans
&nav_tap NAV DEFAULT  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans                 &trans
            >;
        };

        function_layer {
            label = "FUNC";
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&nav_tap NAV DEFAULT  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans  &trans     &trans                  &trans         &trans     &trans  &trans     &trans     &trans
&trans  &trans    &trans    &trans  &trans     &trans                  &trans         &trans     &trans  &trans     &trans     &trans
&trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans                  &kp PAGE_UP    &mkp LCLK  &trans  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &kp PAGE_DOWN  &trans     &trans  &trans     &trans     &trans
&nav_tap NAV DEFAULT  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &mo 4                                        &trans     &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&nav_tap NAV DEFAULT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&nav_tap NAV DEFAULT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };


        nav_layer {
            label = "NAV";
            bindings = <
&trans  &to CANARY   &to GAMING   &to SYM   &to FUN   &to MOUSE   &to SCROLL   &to SNIPE  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };


    };
};
